# Editor defaults for the id Software house style (see AGENTS.md). dprint
# and gofmt own the final layout; this keeps editors from fighting them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[*.{ps1,psm1}]
end_of_line = crlf
