# Nomad servers form the consensus control plane and do not run game tasks.
# Replace every example address and enable Nomad ACL/TLS before deployment.

name       = "nomad-server-1"
data_dir   = "D:/nomad/data"
bind_addr  = "10.0.0.10"
datacenter = "dc1"
log_level  = "INFO"

server {
  enabled          = true
  bootstrap_expect = 3
  oidc_issuer      = "https://nomad.example.com"
  server_join {
    retry_join = ["10.0.0.10", "10.0.0.11", "10.0.0.12"]
  }
}

client {
  enabled = false
}

acl {
  enabled = true
}

tls {
  http = true
  rpc  = true

  ca_file   = "D:/nomad/tls/nomad-agent-ca.pem"
  cert_file = "D:/nomad/tls/server.pem"
  key_file  = "D:/nomad/tls/server-key.pem"

  verify_server_hostname = true
  verify_https_client     = true
}
