# Windows Agent node. Use a dedicated, low-privilege Nomad service account.
# This node owns the singleton login/directory process, not shard authority.

name       = "agent-windows-1"
data_dir   = "D:/nomad/data"
bind_addr  = "10.0.1.10"
datacenter = "dc1"
log_level  = "INFO"

server {
  enabled = false
}

client {
  enabled          = true
  servers          = ["10.0.0.10:4647", "10.0.0.11:4647", "10.0.0.12:4647"]
  max_kill_timeout = "90s"

  # Scheduling metadata is an authority grant. Only the node that owns the
  # Agent directory state may advertise sro_agent=true.
  meta {
    sro_agent  = "true"
    sro_shards = ""
  }

  # GameWorld clients discover this address through Nomad's native service
  # catalog. It must be reachable from every eligible GameWorld node.
  host_network "game-private" {
    cidr = "10.0.1.10/32"
  }
}

plugin "raw_exec" {
  config {
    enabled = true
    # Defense in depth for every native task on this client. The Agent job
    # also denies these names so client configuration drift cannot leak host
    # control-plane credentials into the login process.
    denied_envvars = [
      "NOMAD_TOKEN",
      "NOMAD_LICENSE",
      "NOMAD_LICENSE_PATH",
      "CONSUL_*",
      "VAULT_*",
      "AWS_*",
      "AZURE_*",
      "ARM_*",
      "GOOGLE_*",
      "GITHUB_*",
      "GITLAB_*",
    ]
  }
}

acl {
  enabled = true
}

tls {
  http = true
  rpc  = true

  ca_file   = "D:/nomad/tls/nomad-agent-ca.pem"
  cert_file = "D:/nomad/tls/client.pem"
  key_file  = "D:/nomad/tls/client-key.pem"

  verify_server_hostname = true
  verify_https_client     = true
}
