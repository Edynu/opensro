# Windows GameWorld node. Run the Nomad Windows service under a dedicated,
# low-privilege account with read/execute access to binaries/assets and
# read/write access only to its assigned state directories.

name       = "gameworld-windows-1"
data_dir   = "D:/nomad/data"
bind_addr  = "10.0.1.20"
datacenter = "dc1"
log_level  = "INFO"

server {
  enabled = false
}

client {
  enabled          = true
  servers          = ["10.0.0.10:4647", "10.0.0.11:4647", "10.0.0.12:4647"]
  max_kill_timeout = "90s"

  # Scheduling metadata is an authority grant. List only shards whose
  # authority directories and immutable releases are provisioned on this
  # node. Set sro_agent to "false" on GameWorld-only nodes.
  meta {
    sro_agent  = "false"
    sro_shards = "global-official"
  }

  host_network "game-private" {
    cidr = "10.0.1.20/32"
  }
}

plugin "raw_exec" {
  config {
    enabled = true
    # Defense in depth for every native task on this client. The SRO jobs
    # repeat this denylist so a client configuration drift cannot expose the
    # Nomad control token or host cloud credentials to game code.
    denied_envvars = [
      "NOMAD_TOKEN",
      "NOMAD_LICENSE",
      "NOMAD_LICENSE_PATH",
      "CONSUL_*",
      "VAULT_*",
      "AWS_*",
      "AZURE_*",
      "ARM_*",
      "GOOGLE_*",
      "GITHUB_*",
      "GITLAB_*",
    ]
  }
}

acl {
  enabled = true
}

tls {
  http = true
  rpc  = true

  ca_file   = "D:/nomad/tls/nomad-agent-ca.pem"
  cert_file = "D:/nomad/tls/client.pem"
  key_file  = "D:/nomad/tls/client-key.pem"

  verify_server_hostname = true
  verify_https_client     = true
}
