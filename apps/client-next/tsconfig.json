{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./temp/cache/tsc/client.tsbuildinfo",
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "ES2024.ArrayBuffer",
      "ES2024.SharedMemory",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "tools/types/**/*.d.ts"
  ]
}
