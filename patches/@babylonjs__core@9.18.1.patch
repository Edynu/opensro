diff --git a/Instrumentation/renderingMetrics.d.ts b/Instrumentation/renderingMetrics.d.ts
new file mode 100644
index 0000000000000000000000000000000000000000..79fe6079730e01d9499af588a886a0df5e8b5401
--- /dev/null
+++ b/Instrumentation/renderingMetrics.d.ts
@@ -0,0 +1,89 @@
+/**
+ * Version-pinned semantic render telemetry absent from Babylon's public APIs.
+ * SceneInstrumentation and PerformanceViewer expose aggregate frame/scene data,
+ * not queue, bind-phase, or per-draw WebGPU attribution. Keep this surface
+ * aligned with the application sink; speculative events add hot-path work.
+ * @internal
+ */
+export type RenderingMetricsQueueKind = "depthOnly" | "opaque" | "alphaTest" | "transparent";
+
+export type ActiveMeshEvaluationKind =
+    | "snapshotReset"
+    | "frozenMaintenance"
+    | "fullSelection"
+    | "noCamera";
+
+export type ActiveMeshEvaluationOrigin =
+    | "freezeRequest"
+    | "motionCapture"
+    | "stationaryCapture"
+    | "render"
+    | "external";
+
+export type RenderingMetricsSpanKind =
+    | "renderingManager"
+    | "renderingGroup"
+    | "groupObservable"
+    | "queue"
+    | "queueDispatch"
+    | "subMesh"
+    | "materialReadiness"
+    | "materialPreBind"
+    | "vertexIndexBind"
+    | "materialBind"
+    | "pipelineLookup"
+    | "bindGroupLookup"
+    | "bundleReuse"
+    | "directDrawEncoding";
+
+export type RenderingMetricsEventKind =
+    | "renderingGroupVisited"
+    | "queueVisited"
+    | "bundleCreated"
+    | "bundleReused"
+    | "directDraw";
+
+export type RenderingMetricsReferenceKind =
+    | "mesh"
+    | "material"
+    | "effect";
+
+export interface RenderingMetricsSink {
+    beginActiveMeshEvaluation?(
+        scene: object,
+        kind: ActiveMeshEvaluationKind,
+        origin: ActiveMeshEvaluationOrigin
+    ): void;
+    recordActiveMeshEvaluation?(
+        scene: object,
+        kind: ActiveMeshEvaluationKind,
+        origin: ActiveMeshEvaluationOrigin,
+        durationMs: number,
+        candidateCount: number,
+        selectedCount: number
+    ): void;
+    recordSpan?(
+        kind: RenderingMetricsSpanKind,
+        durationMs: number,
+        queueKind: RenderingMetricsQueueKind | null,
+        itemCount: number,
+        detail: number
+    ): void;
+    recordEvent(
+        kind: RenderingMetricsEventKind,
+        queueKind: RenderingMetricsQueueKind | null,
+        count: number,
+        detail: number
+    ): void;
+    recordReference(
+        kind: RenderingMetricsReferenceKind,
+        queueKind: RenderingMetricsQueueKind | null,
+        value: object | null
+    ): void;
+}
+
+export declare let renderingMetricsSink: RenderingMetricsSink | null;
+export declare function setRenderingMetricsSink(sink: RenderingMetricsSink | null): RenderingMetricsSink | null;
+export declare function getRenderingMetricsQueueKind(): RenderingMetricsQueueKind | null;
+export declare function pushRenderingMetricsQueueKind(kind: RenderingMetricsQueueKind): void;
+export declare function popRenderingMetricsQueueKind(): void;
diff --git a/Instrumentation/renderingMetrics.js b/Instrumentation/renderingMetrics.js
new file mode 100644
index 0000000000000000000000000000000000000000..176ca75144ed733b3d6c318066364c77b56cb4ea
--- /dev/null
+++ b/Instrumentation/renderingMetrics.js
@@ -0,0 +1,44 @@
+/**
+ * Optional semantic rendering metrics seam.
+ *
+ * Babylon's public instrumentation exposes aggregate frame/scene counters,
+ * but not private queue bodies, bind sub-phases, or per-draw WebGPU bundle
+ * decisions. Keep this seam version-pinned and its event surface consumer-led;
+ * do not add speculative callbacks to render hot paths.
+ *
+ * The engine never installs a sink itself. When no sink is present, patched
+ * render hot paths perform only one live-binding null check. Consumers can
+ * install a version-pinned diagnostics sink without replacing Babylon methods
+ * or inferring behavior from private counter deltas.
+ * @internal
+ */
+export let renderingMetricsSink = null;
+
+const queueKindStack = [];
+let queueKindDepth = 0;
+
+export function setRenderingMetricsSink(sink) {
+    const previous = renderingMetricsSink;
+    renderingMetricsSink = sink;
+    if (!sink) {
+        queueKindDepth = 0;
+        queueKindStack.length = 0;
+    }
+    return previous;
+}
+
+export function getRenderingMetricsQueueKind() {
+    return queueKindDepth === 0 ? null : queueKindStack[queueKindDepth - 1];
+}
+
+export function pushRenderingMetricsQueueKind(kind) {
+    queueKindStack[queueKindDepth++] = kind;
+}
+
+export function popRenderingMetricsQueueKind() {
+    if (queueKindDepth === 0) {
+        return;
+    }
+    queueKindDepth--;
+    queueKindStack.length = queueKindDepth;
+}
diff --git a/Materials/retainedShaderBindings.js b/Materials/retainedShaderBindings.js
new file mode 100644
index 0000000000000000000000000000000000000000..f4f2a2024c61b12097c500542c7bc722e13c54aa
--- /dev/null
+++ b/Materials/retainedShaderBindings.js
@@ -0,0 +1,83 @@
+/**
+ * Retain instructions, not values or GPU allocation handles.
+ * ShaderMaterial owns the tables; additions/removals invalidate the plan.
+ * Existing values and in-place object edits are read on execution.
+ * UBO allocation rotation is observed through getBuffer() on EVERY bind.
+ * No effect, scene, mesh or GPU allocation is captured.
+ */
+const fields = [
+    "_textures",
+    "_internalTextures",
+    "_textureArrays",
+    "_ints",
+    "_uints",
+    "_floats",
+    "_floatsArrays",
+    "_colors3",
+    "_colors3Arrays",
+    "_colors4",
+    "_colors4Arrays",
+    "_vectors2",
+    "_vectors3",
+    "_vectors4",
+    "_quaternions",
+    "_matrices",
+    "_matrixArrays",
+    "_matrices3x3",
+    "_matrices2x2",
+    "_vectors2Arrays",
+    "_vectors3Arrays",
+    "_vectors4Arrays",
+    "_quaternionsArrays",
+    "_uniformBuffers",
+    "_externalTextures",
+    "_textureSamplers",
+    "_storageBuffers"
+];
+
+export function createRetainedShaderBindings(material) {
+    const commands = [];
+    for (let kind = 0; kind < fields.length; ++kind) {
+        const table = material[fields[kind]];
+        for (const name in table) commands.push({ kind, table, name });
+    }
+    return commands;
+}
+
+// Avoid a polymorphic closure invocation per binding.
+export function bindRetainedShaderResources(commands, effect, scene) {
+    for (let i = 0; i < commands.length; ++i) {
+        const command = commands[i];
+        const name = command.name;
+        const value = command.table[name];
+        switch (command.kind) {
+            case 0: { effect.setTexture(name, value); break; }
+            case 1: { effect._bindTexture(name, value); break; }
+            case 2: { effect.setTextureArray(name, value); break; }
+            case 3: { effect.setInt(name, value); break; }
+            case 4: { effect.setUInt(name, value); break; }
+            case 5: { effect.setFloat(name, value); break; }
+            case 6: { effect.setArray(name, value); break; }
+            case 7: { effect.setColor3(name, value); break; }
+            case 8: { effect.setArray3(name, value); break; }
+            case 9: { effect.setFloat4(name, value.r, value.g, value.b, value.a); break; }
+            case 10: { effect.setArray4(name, value); break; }
+            case 11: { effect.setVector2(name, value); break; }
+            case 12: { effect.setVector3(name, value); break; }
+            case 13: { effect.setVector4(name, value); break; }
+            case 14: { effect.setQuaternion(name, value); break; }
+            case 15: { effect.setMatrix(name, value); break; }
+            case 16: { effect.setMatrices(name, value); break; }
+            case 17: { effect.setMatrix3x3(name, value); break; }
+            case 18: { effect.setMatrix2x2(name, value); break; }
+            case 19: { effect.setArray2(name, value); break; }
+            case 20: { effect.setArray3(name, value); break; }
+            case 21: { effect.setArray4(name, value); break; }
+            case 22: { effect.setArray4(name, value); break; }
+            case 23: { const buffer = value.getBuffer(); if (buffer) effect.bindUniformBuffer(buffer, name); break; }
+            case 24: { const engine = scene.getEngine(); if (engine.setExternalTexture) engine.setExternalTexture(name, value); break; }
+            case 25: { const engine = scene.getEngine(); if (engine.setTextureSampler) engine.setTextureSampler(name, value); break; }
+            case 26: { const engine = scene.getEngine(); if (engine.setStorageBuffer) engine.setStorageBuffer(name, value); break; }
+        }
+    }
+}
